{
	"name": "client",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"depcruise": "depcruise src",
		"depcruise:graph": "depcruise src --output-type mermaid --output-to dependency-graph.mmd",
		"depcruise:text": "depcruise src --output-type text"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"dependency-cruiser": "^18.4.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"type": "module"
}
